# ============================================================================
# TRADING AGENTS CONFIGURATION - Copy this to .env and fill in your values
# ============================================================================

# DATABASE CONFIGURATION
# Railway PostgreSQL connection string - format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading_agents

# ============================================================================
# BINANCE CONFIGURATION (Testnet for paper trading, Production for real trading)
# ============================================================================

# Trading Mode: TESTNET or PRODUCTION
TRADING_MODE=TESTNET

# Binance Testnet Credentials (for paper trading validation)
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key
BINANCE_TESTNET_SECRET_KEY=your_binance_testnet_secret_key

# Binance Production Credentials (for real trading - only enable after paper testing)
BINANCE_PRODUCTION_API_KEY=your_binance_production_api_key
BINANCE_PRODUCTION_SECRET_KEY=your_binance_production_secret_key

# ============================================================================
# INTERACTIVE BROKERS CONFIGURATION (Optional - for real trading)
# ============================================================================

# IB Gateway Connection
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4002
IB_ACCOUNT_ID=your_ib_account_id
IB_CLIENT_ID=your_ib_client_id

# ============================================================================
# DISCORD NOTIFICATIONS (For all alerts)
# ============================================================================

# Discord Webhook URL for alerts
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id/your_webhook_token

# ============================================================================
# ORDER EXECUTION AGENT CONFIGURATION
# ============================================================================

# Execution interval in milliseconds (default: 5000ms = 5 seconds)
ORDER_EXECUTION_INTERVAL=5000

# Retry configuration
MAX_RETRIES=3
INITIAL_BACKOFF=1000
MAX_BACKOFF=30000

# ============================================================================
# MARKET DATA AGENT CONFIGURATION
# ============================================================================

# Market data interval in milliseconds (default: 10000ms = 10 seconds)
MARKET_DATA_INTERVAL=10000

# Price update threshold: only store price if changed by this % (default: 0.02 = 2%)
PRICE_UPDATE_THRESHOLD=0.02

# ============================================================================
# PORTFOLIO MONITOR AGENT CONFIGURATION
# ============================================================================

# Portfolio monitoring interval in milliseconds (default: 60000ms = 60 seconds)
PORTFOLIO_MONITOR_INTERVAL=60000

# Rebalancing threshold: trigger rebalance if drift > this % (default: 5%)
REBALANCE_THRESHOLD=5

# Minimum position size in USD (default: 10)
MIN_POSITION_SIZE=10

# Maximum orders to queue per rebalancing cycle (default: 10)
MAX_ORDERS_PER_CYCLE=10

# ============================================================================
# RISK MANAGEMENT AGENT CONFIGURATION
# ============================================================================

# Maximum position size as % of portfolio (default: 0.5 = 50%)
MAX_POSITION_SIZE=0.5

# Maximum daily loss as % of portfolio (default: 5%)
MAX_DAILY_LOSS_PERCENT=5

# Maximum leverage (default: 1.0 = spot only, no margin)
MAX_LEVERAGE=1.0

# Minimum price for order (default: 0.00000001)
MIN_PRICE=0.00000001

# Enable/disable trading hours restrictions (default: true)
TRADING_HOURS_ENABLED=true

# ============================================================================
# ERROR RECOVERY AGENT CONFIGURATION
# ============================================================================

# Error recovery interval in milliseconds (default: 300000ms = 5 minutes)
ERROR_RECOVERY_INTERVAL=300000

# Circuit breaker configuration
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=600000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Node environment
NODE_ENV=production
