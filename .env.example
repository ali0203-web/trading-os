# Railway PostgreSQL (provided by Railway)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Binance API Keys (TESTNET for Week 1-2)
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_SECRET_KEY=your_testnet_secret_key_here

# Binance API Keys (PRODUCTION for Week 3+, add later)
BINANCE_LIVE_API_KEY=your_live_api_key_here
BINANCE_LIVE_SECRET_KEY=your_live_secret_key_here

# Interactive Brokers (will add Week 2-3)
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4002
IB_CLIENT_ID=your_ib_client_id
IB_ACCOUNT=your_ib_account_number

# Discord Bot Configuration (I'll create this)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Trading Configuration
TRADING_MODE=TESTNET  # TESTNET or PRODUCTION
INITIAL_CAPITAL=100  # Starting capital in USD
MAX_POSITION_SIZE=0.5  # Max % of portfolio per position
REBALANCE_THRESHOLD=5  # % drift to trigger rebalancing
TRADING_HOURS_START=09:30  # Market open (ET for stocks, UTC for crypto)
TRADING_HOURS_END=16:00    # Market close

# Risk Management
MAX_LEVERAGE=1.0  # No leverage for safety
MAX_DAILY_LOSS_PERCENT=5  # Stop trading if daily loss > 5%
POSITION_SIZE_LIMIT=50000  # Max order size in USD

# Logging & Monitoring
LOG_LEVEL=info  # debug, info, warn, error
ALERT_THRESHOLD_ERRORS=5  # Alert after N errors
ALERT_THRESHOLD_LATENCY=5000  # Alert if latency > 5s (ms)

# Agent Configuration
ORDER_EXECUTION_INTERVAL=5000  # Check queue every 5s (ms)
PORTFOLIO_MONITOR_INTERVAL=60000  # Rebalance check every 1m (ms)
MARKET_DATA_INTERVAL=10000  # Update prices every 10s (ms)
RECONCILIATION_TIME=17:00  # Daily reconciliation after market close (ET)
ERROR_RECOVERY_INTERVAL=300000  # Check DLQ every 5m (ms)

# Retry Configuration
MAX_RETRIES=3
INITIAL_BACKOFF=1000  # Start with 1s, then exponential backoff
MAX_BACKOFF=30000     # Cap at 30s between retries

# Node Environment
NODE_ENV=production
